node_modules/
*/node_modules/
dist/
*/dist/
build/
*/build/
.turbo/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python & Backend ---
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
